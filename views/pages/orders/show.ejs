<section class="page-section">
  <div class="container">
    <div class="detail-hero card">
      <div class="detail-hero-main">
        <div class="detail-topline">
          <span class="status-badge status-<%= detail.order.status %>"><%= helpers.statusLabel(detail.order.status) %></span>
          <span class="muted-text">Створено <%= helpers.formatDate(detail.order.created_at) %></span>
        </div>

        <h1><%= detail.order.title %></h1>
        <p class="lead"><%= detail.order.description %></p>

        <div class="detail-meta-grid">
          <div><span>Замовник</span><strong><%= detail.order.customer_name %></strong></div>
          <div><span>Виконавець</span><strong><%= detail.order.performer_name || 'Ще не призначено' %></strong></div>
          <div><span>Спеціальність</span><strong><%= detail.order.specialty_title || '—' %></strong></div>
          <div><span>Категорія</span><strong><%= detail.order.category_name || '—' %></strong></div>
          <div><span>Дедлайн</span><strong><%= helpers.formatDate(detail.order.deadline) %></strong></div>
          <div><span>Прогрес</span><strong><%= detail.order.progress %>%</strong></div>
        </div>
      </div>

      <div class="detail-hero-side">
        <div class="progress-ring-card">
          <div class="progress-ring-label">Прогрес виконання</div>
          <div class="progress-value"><%= detail.order.progress %>%</div>
          <div class="progress-bar large"><span style="width:<%= detail.order.progress %>%"></span></div>
        </div>

        <% if (detail.permissions.canApply && !detail.currentApplication) { %>
          <form action="/orders/<%= detail.order.id %>/apply" method="post" class="form-stack">
            <div class="field">
              <label for="applicationMessage">Повідомлення до заявки</label>
              <textarea
                id="applicationMessage"
                name="message"
                rows="3"
                placeholder="Коротко опишіть, чому ви можете виконати це замовлення."
              ></textarea>
            </div>
            <button type="submit" class="btn btn-primary btn-block">Подати заявку</button>
          </form>
        <% } else if (detail.currentApplication) { %>
          <div class="empty-state small">
            <h3>Заявку вже подано</h3>
          <p>
  Статус заявки:
  <strong>
    <%= detail.currentApplication.status === 'pending'
      ? 'Очікує підтвердження'
      : detail.currentApplication.status === 'accepted'
      ? 'Прийнято'
      : 'Відхилено' %>
  </strong>
</p>
          </div>
        <% } %>
      </div>
    </div>

    <% if (detail.permissions.canManageApplications) { %>
      <article class="card section-card top-gap">
        <div class="section-card-header">
          <h2>Заявки виконавців</h2>
          <span class="muted-text">Замовник може обрати одного виконавця для роботи</span>
        </div>

        <% if (detail.applications && detail.applications.length) { %>
          <div class="list-stack">
            <% detail.applications.forEach((application) => { %>
              <div class="list-row">
                <div>
                  <strong><%= application.performer_name %></strong>
                  <p>
                    <%= application.specialty_name || 'Спеціальність не вказана' %>
                    · рейтинг <%= Number(application.rating_avg || 0).toFixed(2) %>
                    · <%= application.level_label %>
                  </p>

                  <% if (application.message) { %>
                    <p><%= application.message %></p>
                  <% } else { %>
                    <p class="muted-text">Повідомлення до заявки відсутнє.</p>
                  <% } %>

                  <small>Подано <%= helpers.formatDateTime(application.created_at) %></small>
                </div>

                <div class="row-meta right-align">
                  <span class="status-badge status-<%= application.status %>">
                    <%= application.status === 'pending' ? 'Очікує' : application.status === 'accepted' ? 'Прийнято' : 'Відхилено' %>
                  </span>

                  <% if (application.status === 'pending') { %>
                    <form action="/orders/<%= detail.order.id %>/applications/<%= application.id %>/accept" method="post">
                      <button type="submit" class="btn btn-primary">Прийняти</button>
                    </form>
                  <% } %>
                </div>
              </div>
            <% }) %>
          </div>
        <% } else { %>
          <div class="empty-state small">
            <h3>Заявок ще немає</h3>
            <p>Коли виконавці подадуть заявки, вони з’являться у цьому блоці.</p>
          </div>
        <% } %>
      </article>
    <% } %>

    <div class="content-grid two-wide-one-narrow top-gap">
      <div class="main-stack">
<article class="card section-card">
  <div class="section-card-header">
    <h2>Керування замовленням</h2>
  </div>

  <div class="form-grid action-grid">

    <% if (
      detail.permissions.isPerformer &&
      (
        detail.order.status === 'in_progress' ||
        detail.order.status === 'needs_revision'
      )
    ) { %>

      <form
        action="/orders/<%= detail.order.id %>/submit-review"
        method="post"
        class="inline-card-form"
      >
        <button type="submit" class="btn btn-primary">
          Передати на перевірку
        </button>
      </form>

    <% } %>

    <% if (
      detail.permissions.isCustomer &&
      detail.order.status === 'pending_review'
    ) { %>

      <form
        action="/orders/<%= detail.order.id %>/confirm"
        method="post"
        class="inline-card-form"
      >
        <button type="submit" class="btn btn-primary">
          Підтвердити виконання
        </button>
      </form>

      <form
        action="/orders/<%= detail.order.id %>/revision"
        method="post"
        class="inline-card-form"
      >
        <button type="submit" class="btn btn-outline">
          На доопрацювання
        </button>
      </form>

    <% } %>

    <% if (detail.permissions.canUpdateProgress) { %>

      <form
        action="/orders/<%= detail.order.id %>/progress"
        method="post"
        class="inline-card-form"
      >
        <div class="field no-margin">
          <label for="progress">Прогрес, %</label>

          <input
            id="progress"
            name="progress"
            type="number"
            min="0"
            max="100"
            value="<%= detail.order.progress %>"
            placeholder="0-100"
          />
        </div>

        <button type="submit" class="btn btn-outline">
          Зберегти прогрес
        </button>
      </form>

    <% } %>

  </div>
</article>

        <article class="card section-card" id="chat">
          <div class="section-card-header">
            <h2>Чат замовлення</h2>
            <% if (detail.permissions.canUsePrivateBlocks) { %>
              <span class="muted-text">Історія повідомлень синхронізується автоматично</span>
            <% } %>
          </div>

          <% if (detail.permissions.canUsePrivateBlocks) { %>
            <div class="message-thread" data-chat-order-id="<%= detail.order.id %>" data-current-user-id="<%= currentUser.id %>">
              <div class="message-list" data-message-list>
                <% detail.messages.forEach((message) => { %>
                  <article class="message-item <%= message.sender_id === currentUser.id ? 'is-own' : '' %>">
                    <div class="message-bubble">
                      <strong><%= message.sender_name %></strong>
                      <p><%= message.body %></p>
                      <small><%= helpers.formatDateTime(message.created_at) %></small>
                    </div>
                  </article>
                <% }) %>
              </div>
            </div>

            <form action="/orders/<%= detail.order.id %>/messages" method="post" class="chat-form">
              <textarea name="message" rows="3" placeholder="Напишіть коротке повідомлення для учасників замовлення."></textarea>
              <button type="submit" class="btn btn-primary">Надіслати повідомлення</button>
            </form>
          <% } else { %>
            <div class="empty-state small">
              <h3>Чат стане доступним після призначення виконавця</h3>
              <p>Повідомлення можуть бачити лише замовник, обраний виконавець і адміністратор.</p>
            </div>
          <% } %>
        </article>

        <article class="card section-card" id="files">
          <div class="section-card-header">
            <h2>Файли</h2>
          </div>

          <% if (detail.permissions.canUsePrivateBlocks) { %>
            <form action="/orders/<%= detail.order.id %>/files" method="post" enctype="multipart/form-data" class="file-upload-form">
              <input type="file" name="attachment" />
              <button type="submit" class="btn btn-secondary">Завантажити файл</button>
            </form>

            <% if (detail.files.length) { %>
              <div class="list-stack file-list">
                <% detail.files.forEach((file) => { %>
                  <a href="/orders/files/<%= file.id %>/download" class="list-row list-row-link">
                    <div>
                      <strong><%= file.original_name %></strong>
                      <p>Завантажив: <%= file.uploaded_by_name %></p>
                    </div>
                    <div class="row-meta right-align">
                      <span><%= Math.max(1, Math.round(file.size_bytes / 1024)) %> KB</span>
                      <span><%= helpers.formatDateTime(file.created_at) %></span>
                    </div>
                  </a>
                <% }) %>
              </div>
            <% } else { %>
              <p class="empty-state small">Ще немає прикріплених файлів.</p>
            <% } %>
          <% } else { %>
            <div class="empty-state small">
              <h3>Файли доступні лише учасникам</h3>
              <p>Після призначення виконавця тут з’явиться файловий блок для обміну матеріалами.</p>
            </div>
          <% } %>
        </article>

        <article class="card section-card" id="review">
          <div class="section-card-header">
            <h2>Відгук і рейтинг</h2>
          </div>

   <% if (detail.order.review_id) { %>
  <div class="review-card clean-review">
    <div class="review-top">
      <div>
        <span class="review-label">Оцінка виконання</span>
        <div class="review-score">
          <%= detail.order.review_rating %> / 5
        </div>
      </div>

      <div class="review-stars">
        <% for (let i = 1; i <= 5; i += 1) { %>
          <span class="<%= i <= detail.order.review_rating ? 'active' : '' %>">★</span>
        <% } %>
      </div>
    </div>

    <div class="review-text">
      <span class="review-label">Текстовий відгук</span>
      <p><%= detail.order.review_text %></p>
    </div>

    <div class="review-points">
      Нараховано репутаційних балів:
      <strong><%= detail.order.reputation_awarded %></strong>
    </div>
  </div>
<% } else if (detail.permissions.canReview) { %>
            <form action="/orders/<%= detail.order.id %>/review" method="post" class="form-stack">
  <div class="review-form-grid">
  <div class="field">
  <label>Оцінка виконання</label>

  <div class="rating-options">
    <% for (let i = 5; i >= 1; i -= 1) { %>
      <label class="rating-option">
        <input type="radio" name="rating" value="<%= i %>" required>
        <span><%= i %> ★</span>
      </label>
    <% } %>
  </div>
</div>

              <div class="field">
                <label for="reviewText">Текстовий відгук</label>
                <textarea id="reviewText" name="reviewText" rows="5" placeholder="Опишіть якість виконання, сильні сторони та результат співпраці." required></textarea>
              </div>

              <button type="submit" class="btn btn-primary">Зберегти відгук</button>
            </form>
          <% } else { %>
            <p class="empty-state small">Відгук стане доступним після завершення замовлення та підтвердження результату замовником.</p>
          <% } %>
        </article>
      </div>

      <aside class="sidebar-stack">
        <article class="card section-card">
          <div class="section-card-header">
            <h2>Журнал активності</h2>
          </div>

          <div class="timeline-list">
            <% detail.activity.forEach((item) => { %>
              <div class="timeline-item">
                <span class="timeline-dot"></span>
                <div>
                  <strong><%= item.title %></strong>
                  <p><%= item.description || 'Опис відсутній.' %></p>
                  <small>
                    <%= helpers.formatDateTime(item.created_at) %>
                    <% if (item.actor_name) { %> · <%= item.actor_name %><% } %>
                  </small>
                </div>
              </div>
            <% }) %>
          </div>
        </article>

        <article class="card section-card">
          <div class="section-card-header">
            <h2>Пам'ятка</h2>
          </div>

          <div class="note-list">
            <div class="note-item">Виконавець спочатку подає заявку, а замовник обирає кандидата.</div>
            <div class="note-item">Чат і файли доступні після призначення виконавця.</div>
            <div class="note-item">Замовник підтверджує завершення роботи та залишає відгук.</div>
          </div>
        </article>
      </aside>
    </div>
  </div>
</section>